{
  "name": "pixelproof-cli",
  "version": "0.1.0-rc.2",
  "description": "Compare AI-generated UIs against reference screenshots. Local-first visual diffs, offline reports, and agent-friendly feedback.",
  "type": "module",
  "bin": {
    "pixelproof": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsup --watch",
    "pixelproof": "node ./dist/cli/index.js",
    "demo:gif": "node scripts/make-demo-gif.mjs",
    "example:basic-ui": "node scripts/example-basic-ui.mjs"
  },
  "keywords": [
    "visual-regression",
    "playwright",
    "ai-coding",
    "screenshot-diff",
    "developer-tools",
    "typescript",
    "pixelmatch",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flower1201/pixelproof.git"
  },
  "homepage": "https://github.com/flower1201/pixelproof#readme",
  "bugs": {
    "url": "https://github.com/flower1201/pixelproof/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.51.1",
    "sharp": "^0.34.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pixelmatch": "^5.2.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.27.7": true
  }
}
